<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:paddingTop="40dp"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity2">

    <TextView
        android:id="@+id/viewPalabra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hint_palabra" />

    <EditText
        android:id="@+id/txtPalabra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:inputType="text"
        android:labelFor="@+id/viewPalabra"
        android:minHeight="50dp"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/viewDefinicion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hint_definicion" />

    <EditText
        android:id="@+id/txtDefinicion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:minHeight="48dp"
        android:labelFor="@+id/viewDefinicion2"
        android:inputType="text"
        android:textSize="24sp" />

    <Button
        android:id="@+id/btnGuardar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/btn_Guardar"
        android:textSize="24sp" />

    <Button
        android:id="@+id/btnEditar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/btn_Editar"
        android:textSize="24sp" />

    <Button
        android:id="@+id/btnBorrar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/btn_Borrar"
        android:textSize="24sp" />

</LinearLayout>